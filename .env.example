# ---------------------------------------------------------------------------
# doc-rag configuration. Copy to .env and edit; every value has a default.
# ---------------------------------------------------------------------------

# --- LLM (answer generation) ----------------------------------------------
# MOCK_LLM=1 needs no key at all: the answer is the top retrieved passages.
MOCK_LLM=0
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=sk-ant-...
# low | medium | high | xhigh | max - grounded extraction does not need much
LLM_EFFORT=low
LLM_MAX_TOKENS=4096
# cheaper model used only by the eval faithfulness judge
JUDGE_MODEL=claude-haiku-5-5

# --- Embeddings (retrieval; no key needed) --------------------------------
# sentence-transformers (local model) | hash (dependency-free fallback)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# --- Storage ---------------------------------------------------------------
DATA_DIR=data
COLLECTION=doc_rag

# --- Chunking --------------------------------------------------------------
CHUNK_TARGET_TOKENS=650
CHUNK_MAX_TOKENS=800
CHUNK_MIN_TOKENS=60
CHUNK_OVERLAP_RATIO=0.12

# --- Retrieval -------------------------------------------------------------
TOP_K=6
CANDIDATE_K=24
RRF_K=60
USE_RERANKER=0
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# How much of a question's topic vocabulary must appear in the retrieved
# passages before MOCK mode is willing to answer (real LLMs judge for
# themselves). Lower it if mock mode refuses too eagerly.
MOCK_MIN_COVERAGE=0.75
